# Tekti: выберите ОДИН из способов ниже и раскомментируйте его строки. Реальные значения сюда не вписывайте:
# скопируйте файл в .env (он в .gitignore) и заполните уже там.
# Порядок умолчаний: явные TEKTI_PANEL и т.п. > ключи поставщиков > OpenRouter > Amazon Bedrock.

# --- 1. Свои ключи поставщиков — основной способ (можно задать не все: коллегия соберётся из доступных) ---------
# OPENAI_API_KEY=<ключ OpenAI>
# ANTHROPIC_API_KEY=<ключ Anthropic>
# GOOGLE_API_KEY=<ключ Gemini API>

# --- 2. Один ключ OpenRouter вместо трёх: те же модели через openrouter.ai (ключ: openrouter.ai/keys) ---
# Используется, если не задан ни один ключ поставщика; TEKTI_PROVIDER=openrouter включает его явно.
# OPENROUTER_API_KEY=<ключ OpenRouter>

# --- Другое: только бесплатный ключ Gemini (одно семейство, gemini-4-hydrogen; слабее полной коллегии) ------------
# GOOGLE_API_KEY=<ключ из aistudio.google.com/apikey>

# --- Другое: Amazon Bedrock (прежний режим; учётные данные AWS_PROFILE / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) --
# TEKTI_PROVIDER=bedrock
# TEKTI_REGION=us-east-1
# TEKTI_BACKEND=strands

# --- Переопределение моделей: [провайдер:][семейство:]model_id, провайдеры можно смешивать --------------------
# По умолчанию (А/Б): коллегия openai:gpt-6.1-terra, anthropic:claude-haiku-5-5, google:gemini-4-carbon
# (при перегрузке gemini-4-hydrogen, затем gemini-3.5-flash-lite); нарезка anthropic:claude-haiku-5-5; группировка и вопросы openai:gpt-6.1-terra.
# TEKTI_PANEL=openai:gpt-6.1-terra,anthropic:claude-haiku-5-5,google:gemini-4-carbon
# TEKTI_SEGMENTER=anthropic:claude-haiku-5-5
# TEKTI_MERGE_MODEL=openai:gpt-6.1-terra
# Глубина рассуждений по этапам и проверка доступности Gemini перед прогоном:
# TEKTI_REASONING=segment=off,panel=medium,google:panel=low,challenge=low,merge=low,questions=medium
# TEKTI_PROBE_TIMEOUT=45
# TEKTI_QUESTION_WRITER=openai:gpt-6.1-terra
# Пример смешанной коллегии с моделью Bedrock:
# TEKTI_PANEL=openai:gpt-6.1-terra,anthropic:claude-haiku-5-5,bedrock:mistral:mistral.mistral-large-3-675b-instruct

# --- Любой другой OpenAI-совместимый эндпоинт (Ollama и т.п.) ---------------------------------------------------
# TEKTI_PROVIDER=openai_compatible
# TEKTI_BASE_URL=http://localhost:11434/v1
# TEKTI_API_KEY=<ключ, если нужен>
# TEKTI_PANEL=qwen:qwen3:32b

# --- Прочие настройки --------------------------------------------------------------------------------------------
# TEKTI_LENSES=functional,api_contract,data_integration,tester,developer
# TEKTI_MAX_PARALLEL=6
# TEKTI_MAX_OUTPUT_TOKENS=12000

# --- Шлюз автора (для проверки жюри не нужен): ключи автора после входа через GitHub, см. gateway/README.md ---
# Сообщите автору свой логин GitHub; затем задайте адрес, выполните `uv run tekti login` и подтвердите вход
# в браузере. Если адрес задан, все модели идут через шлюз, даже когда заданы и свои ключи.
# TEKTI_GATEWAY_URL=https://ogy3dekojptszeoxe33vuqjp5y0ngjyp.lambda-url.us-east-1.on.aws
# Только для автора шлюза: токен владельца вместо входа через GitHub.
# TEKTI_GATEWAY_TOKEN=<токен владельца>
# Client ID OAuth-приложения GitHub, если отличается от встроенного.
# TEKTI_GITHUB_CLIENT_ID=<client id>
