# Основной блок конфигурации для бесплатного Google AI Studio (Gemini API через OpenAI-совместимый эндпоинт)
TEKTI_PROVIDER=openai_compatible
TEKTI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TEKTI_API_KEY=PASTE_YOUR_API_KEY_HERE
TEKTI_PANEL=google:gemini-2.5-flash
TEKTI_SEGMENTER=google:gemini-2.5-flash
TEKTI_QUESTION_WRITER=google:gemini-2.5-flash

# Альтернативный блок для Amazon Bedrock (мультисемейная доска по умолчанию при TEKTI_PROVIDER=bedrock с учетными данными AWS_PROFILE / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION)
# TEKTI_PROVIDER=bedrock
# TEKTI_BACKEND=strands
# TEKTI_REGION=us-east-1
# TEKTI_PANEL=anthropic:us.anthropic.claude-haiku-4-5-20251001-v1:0,openai:openai.gpt-oss-120b-1:0,moonshot:us.moonshotai.kimi-k3.1
# TEKTI_SEGMENTER=anthropic:us.anthropic.claude-haiku-4-5-20251001-v1:0
# TEKTI_QUESTION_WRITER=anthropic:us.anthropic.claude-haiku-4-5-20251001-v1:0

# Опциональные переменные настройки
# TEKTI_LENSES=functional,api_contract,data_integration,tester,developer
# TEKTI_MAX_PARALLEL=6
# TEKTI_MAX_OUTPUT_TOKENS=12000
